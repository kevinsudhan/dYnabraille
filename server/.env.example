# DynaBraille processing server. Copy to .env and fill in.

# ---- ElevenLabs (voice assistant + spoken announcements) ----
# API key: https://elevenlabs.io/app/settings/api-keys
# Needs "ElevenLabs Agents", "Text to Speech" and "Speech to Text" permissions.
ELEVENLABS_API_KEY=
# Filled in for you by: python scripts/provision_agent.py
ELEVENLABS_AGENT_ID=
# Voice for the agent and announcements (default: George). Browse: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Speech-to-text for the phone's hold-to-talk button. Language empty = auto-detect.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_LANGUAGE=en
# Optional LLM override for the agent, e.g. gemini-2.5-flash. Empty = ElevenLabs default.
ELEVENLABS_LLM=

# ---- ESP32 braille cell ----
# Shared secret; must match DEVICE_TOKEN in firmware/dynabraille_esp32/config.h.
# Letters, digits, '-' and '_' only.
DEVICE_TOKEN=change-me
# USB serial link: empty = off, "auto" = find the ESP32, or a port like COM5.
# Leave it off while flashing firmware: a serial port can only be open in one program.
DEVICE_SERIAL_PORT=

# ---- Network ----
HTTP_PORT=8000
# iOS only allows camera access over HTTPS. 0 disables it.
HTTPS_PORT=8443
# Advertise over mDNS: the ESP32 finds the server automatically and the
# iPhone can use https://dynabraille.local:8443/camera
MDNS_ENABLED=true
MDNS_HOSTNAME=dynabraille

# ---- Vision ----
VISION_ENABLED=true
# Ultralytics model, downloaded to server/models on first run.
# yolo11n.pt is fast on a laptop CPU; yolo11s.pt is more accurate but slower.
YOLO_MODEL=yolo11n.pt
# Optional extra camera besides the iPhone page: a webcam index (0) or an MJPEG/RTSP URL.
CAMERA_SOURCE=
